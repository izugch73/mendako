<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Mendako.SpritePreview</RootNamespace>
    <!-- 参照する Mendako.App が x64 固定なので揃える。AnyCPU のままだとアーキテクチャ不一致の警告が出る -->
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mendako.App\Mendako.App.csproj" />
    <ProjectReference Include="..\..\src\Mendako.Core\Mendako.Core.csproj" />
  </ItemGroup>

</Project>
