<Window x:Class="Mendako.App.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Mendako.App.Views"
        Title="Mendako"
        Width="260"
        Height="270"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        Background を {x:Null} にしているのが肝。Transparent だと透明な余白まで
        WPF のヒットテスト対象になり、メンダコの周りでクリックが吸われてしまう。
    -->

    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#F0232028" />
        <SolidColorBrush x:Key="CardForeground" Color="#FFF4EDEF" />
        <SolidColorBrush x:Key="CardMuted" Color="#FFAFA2A8" />
        <SolidColorBrush x:Key="TrackBrush" Color="#FF463C43" />
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="PetContextMenu">
            <MenuItem x:Name="FeedMenuItem" Header="ごはんをあげる" Click="OnFeedClick" />
            <MenuItem x:Name="PetMenuItem" Header="なでる" Click="OnPetClick" />
            <MenuItem x:Name="SleepMenuItem" Header="寝かせる" Click="OnSleepToggleClick" />
            <Separator />
            <MenuItem Header="終了" Click="OnExitClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="RootGrid" Background="{x:Null}">

        <!-- ホバー時に出るステータスカード -->
        <Border x:Name="StatusCard"
                Width="230"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,4,0,0"
                Padding="14,12,14,13"
                CornerRadius="12"
                Background="{StaticResource CardBackground}"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" Color="#FF000000" />
            </Border.Effect>

            <StackPanel>
                <TextBlock x:Name="NameText"
                           Text="めんちゃん"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource CardForeground}" />
                <TextBlock x:Name="SubtitleText"
                           Text="たまご / ふつう"
                           FontSize="11"
                           Margin="0,1,0,8"
                           Foreground="{StaticResource CardMuted}" />

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="おなか" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource CardMuted}" />
                    <Border Grid.Column="1" Width="156" HorizontalAlignment="Left" Height="6" CornerRadius="3" Background="{StaticResource TrackBrush}" VerticalAlignment="Center">
                        <Border x:Name="SatietyBar" Width="0" Height="6" CornerRadius="3" HorizontalAlignment="Left" Background="#FFF2A0AF" />
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="げんき" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource CardMuted}" />
                    <Border Grid.Column="1" Width="156" HorizontalAlignment="Left" Height="6" CornerRadius="3" Background="{StaticResource TrackBrush}" VerticalAlignment="Center">
                        <Border x:Name="EnergyBar" Width="0" Height="6" CornerRadius="3" HorizontalAlignment="Left" Background="#FF7EC8B4" />
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="なつき" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource CardMuted}" />
                    <Border Grid.Column="1" Width="156" HorizontalAlignment="Left" Height="6" CornerRadius="3" Background="{StaticResource TrackBrush}" VerticalAlignment="Center">
                        <Border x:Name="AffectionBar" Width="0" Height="6" CornerRadius="3" HorizontalAlignment="Left" Background="#FFE0C27E" />
                    </Border>
                </Grid>

                <TextBlock x:Name="GrowthText"
                           Text=""
                           FontSize="10"
                           Foreground="{StaticResource CardMuted}" />
                <TextBlock Text="クリックでなでる / ダブルクリックでごはん"
                           FontSize="9"
                           Margin="0,6,0,0"
                           Foreground="#FF7E7278" />
            </StackPanel>
        </Border>

        <views:MendakoVisual x:Name="Visual"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Bottom" />
    </Grid>
</Window>
