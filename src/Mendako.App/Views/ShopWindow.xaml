<Window x:Class="Mendako.App.Views.ShopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="おみせ"
        Width="400"
        Height="670"
        MinWidth="360"
        MinHeight="340"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource CardForeground}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="おみせ"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource CardForeground}" />
                <TextBlock Text="かいがらで かざりを かって つけられるよ"
                           FontSize="11"
                           Margin="0,1,0,0"
                           Foreground="{StaticResource CardMuted}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="かいがら"
                           FontSize="10"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource CardMuted}" />
                <TextBlock x:Name="ShellsText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource AccentGold}" />
            </StackPanel>
        </Grid>

        <!-- 窓を小さくされても全部の行に届くよう、行の並びだけスクロールさせる -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel x:Name="Rows" Margin="0,0,4,0" />
        </ScrollViewer>

        <TextBlock x:Name="MessageText"
                   Grid.Row="2"
                   Margin="0,10,0,0"
                   MinHeight="16"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource AccentTeal}" />

        <Button Grid.Row="3"
                Content="とじる"
                IsCancel="True"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                Style="{StaticResource MendakoButton}"
                Click="OnCloseClick" />
    </Grid>
</Window>
