<?xml version="1.0" encoding="utf-8"?>
<!--
  配布用の設定。dotnet publish -p:PublishProfile=win-x64 で使う。

  自己完結にしてあるのは、渡す相手に .NET 8 Desktop Runtime を入れさせないため。
  exe 単体で 63 MB になるが、ランタイム依存だと 250 KB の代わりに
  「まずランタイムを入れてください」を説明することになる。
  WPF は PublishTrimmed に対応しないので、ここから縮める余地はない。
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- これを外すとネイティブ DLL が exe の隣に散らばり、単一ファイルでなくなる -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- DebugType は自分の分しか効かない。これを指定しないと
         参照している Core / Platform の .pdb が exe の隣に落ちて、単一ファイルにならない -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
</Project>
